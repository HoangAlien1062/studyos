# ==============================================================================
# STUDYOS - ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# Copy this file to .env and configure your credentials:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER PORTS
# ------------------------------------------------------------------------------
PORT=5173
VITE_PORT=5173
AI_SERVER_PORT=5001
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. SUPABASE DATABASE & STORAGE (ONLINE SYNC - OPTIONAL)
# Sign up at https://supabase.com, create a project, and run supabase_schema.sql
# If omitted or left blank, StudyOS runs in 100% offline local mode (localStorage / IndexedDB)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
# Optional service role key for backend administration
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. AI PROVIDER API KEYS (AT LEAST ONE KEY ENABLES FULL AI CAPABILITIES)
# API Keys can also be entered directly and updated securely in the Web UI (Cài đặt AI)
# ------------------------------------------------------------------------------
# Google Gemini API (Recommended for free tier and fastest Vietnamese response)
# Get key from https://aistudio.google.com/
GOOGLE_API_KEY=

# OpenAI API Key (GPT-4o, GPT-4o-mini)
# Get key from https://platform.openai.com/
OPENAI_API_KEY=

# Anthropic Claude API Key (Claude 3.5 Sonnet)
# Get key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# DeepSeek API Key (DeepSeek-V3, DeepSeek-R1 reasoning)
# Get key from https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# OpenRouter Unified API Key (Access to 100+ models)
# Get key from https://openrouter.ai/
OPENROUTER_API_KEY=

# Custom OpenAI-compatible Endpoint (Ollama, vLLM, LocalAI)
# Example: http://localhost:11434/v1
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=llama3:8b

# ------------------------------------------------------------------------------
# 4. SECURITY & ENCRYPTION
# 32-character hexadecimal key for AES-256-GCM encryption of stored API keys
# If omitted, a deterministic device-based key is automatically derived
# ------------------------------------------------------------------------------
STUDYOS_SECRET_KEY=e83a218f0a6d94e7c1529bf336829de41e01865c3b9b47e8a931c8241fb7c210
