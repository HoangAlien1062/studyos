# ==============================================================================
# STUDYOS ENVIRONMENT VARIABLES (VERCEL / PRODUCTION / LOCAL)
# ==============================================================================

# 1. Supabase Connection (Public & Service Role)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Google Drive System Storage (Admin-managed)
# Set these on Vercel Dashboard -> Settings -> Environment Variables
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=your-google-drive-refresh-token
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-google-drive-folder-id

# 3. AI Providers (Optional - Server-side only)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
